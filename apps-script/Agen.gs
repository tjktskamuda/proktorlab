  "",
  "function Save-State {",
  "  try {",
  "    $o = @{ done = @($Done | Select-Object -Last 300); results = @($Results); examFound = $script:ExamFound; examLearned = @($ExamLearned) }",
  "    [IO.File]::WriteAllText($StateFile, (ConvertTo-Json -InputObject $o -Depth 5 -Compress), (New-Object Text.UTF8Encoding($false)))",
  "  } catch { Write-Log ('Gagal simpan state: ' + $_.Exception.Message) }",
  "}",
  "",
  "function Load-State {",
  "  if (-not (Test-Path $StateFile)) { return }",
  "  try {",
  "    $s = Get-Content $StateFile -Raw | ConvertFrom-Json",
  "    foreach ($d in @($s.done)) { if ($d) { [void]$Done.Add([string]$d) } }",
  "    if ($s.examFound) { $script:ExamFound = [string]$s.examFound }",
  "    foreach ($n in @($s.examLearned)) { if ($n -and -not ($ExamLearned -contains [string]$n)) { [void]$ExamLearned.Add([string]$n) } }",
  "    foreach ($r in @($s.results)) {",
  "      if ($r -and $r.id) { [void]$Results.Add(@{ id = [string]$r.id; s = [string]$r.s; o = [string]$r.o; t = $r.t }) }",
  "    }",
  "  } catch { Write-Log 'state.json rusak, diabaikan.' }",
  "}",
  "",
  "function Get-NowMs { return [double][DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds() }",
  "function Get-ServerNow { return (Get-NowMs) + $script:Offset }",
  "",
  "function Get-Broadcast([string]$ip, [int]$prefix) {",
  "  try {",
  "    $b = ([System.Net.IPAddress]::Parse($ip)).GetAddressBytes()",
  "    $out = @()",
  "    for ($k = 0; $k -lt 4; $k++) {",
  "      $bits = [math]::Max(0, [math]::Min(8, $prefix - 8 * $k))",
  "      $m = [int](256 - [math]::Pow(2, 8 - $bits))",
  "      $out += ([int]$b[$k] -band $m) -bor (255 - $m)",
  "    }",
  "    return ($out -join '.')",
  "  } catch { return '' }",
  "}",
  "",
  "function Get-Info {",
  "  $i = @{ ip = ''; mac = ''; bc = ''; os = '' }",
  "  try {",
  "    $osr = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop",
  "    $cv = Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -ErrorAction SilentlyContinue",
  "    $dv = $cv.DisplayVersion",
  "    if (-not $dv) { $dv = $cv.ReleaseId }",
  "    $cap = ([string]$osr.Caption) -replace '^Microsoft\\s+', ''",
  "    if ($dv) { $i.os = $cap + ' (' + $dv + ')' } else { $i.os = $cap }",
  "  } catch {}",
  "  try {",
  "    $c = Get-NetIPConfiguration -ErrorAction Stop |",
  "      Where-Object { $_.IPv4DefaultGateway -ne $null -and $_.NetAdapter.Status -eq 'Up' } |",
  "      Select-Object -First 1",
  "    if ($c) {",
  "      $a = @($c.IPv4Address)[0]",
  "      $i.ip = [string]$a.IPAddress",
  "      $i.mac = ([string]$c.NetAdapter.MacAddress -replace '-', ':').ToUpper()",
  "      $i.bc = Get-Broadcast $a.IPAddress ([int]$a.PrefixLength)",
  "    }",
  "  } catch {}",
  "  if (-not $i.ip) {",
  "    try {",
  "      $n = Get-CimInstance Win32_NetworkAdapterConfiguration -Filter 'IPEnabled=True' |",
  "        Where-Object { $_.DefaultIPGateway } | Select-Object -First 1",
  "      if ($n) {",
  "        $i.ip = [string](@($n.IPAddress | Where-Object { $_ -match '^\\d+\\.\\d+\\.\\d+\\.\\d+$' })[0])",
  "        $i.mac = ([string]$n.MACAddress).ToUpper()",
  "        $mask = [string](@($n.IPSubnet)[0])",
  "        $pre = 0",
  "        foreach ($oct in $mask.Split('.')) { $pre += ([Convert]::ToString([int]$oct, 2).ToCharArray() | Where-Object { $_ -eq '1' }).Count }",
  "        $i.bc = Get-Broadcast $i.ip $pre",
  "      }",
  "    } catch {}",
  "  }",
  "  return $i",
  "}",
  "",
  "function Get-LoggedUser {",
  "  try {",
  "    $u = (Get-CimInstance Win32_ComputerSystem -ErrorAction Stop).UserName",
  "    if ($u) { return [string]$u }",
  "  } catch {}",
  "  try {",
  "    $p = Get-CimInstance Win32_Process -Filter \"Name='explorer.exe'\" -ErrorAction Stop | Select-Object -First 1",
  "    if ($p) {",
  "      $o = Invoke-CimMethod -InputObject $p -MethodName GetOwner",
  "      if ($o.User) { return ([string]$o.Domain + '\\' + [string]$o.User) }",
  "    }",
  "  } catch {}",
  "  if ($env:PROKTORLAB_TEST_USER) { return [string]$env:PROKTORLAB_TEST_USER }   # hanya untuk pengujian",
  "  return ''",
  "}",
  "",
  "function Get-ExamNames {",
  "  $names = @()",
  "  if ($script:ExamProc) {",
  "    $names = @($script:ExamProc.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ })",
  "  } else {",
  "    $p = $script:ExamUsed",
  "    if (-not $p) { $p = @(Get-ExamCandidates)[0] }",
  "    if ($p) { $names = @((Get-Leaf $p) -replace '\\.exe$', '') }",
  "  }",
  "  foreach ($n in $ExamLearned) { if ($names -notcontains $n) { $names += $n } }",
  "  return $names",
  "}",
  "",
  "# Pelajari nama proses yang dibuat Exam Browser (misalnya runningexam.exe pada",
  "# Exambrowser ANBK) supaya status dan #Close ExamBrowser tetap mengenalinya",
  "# walaupun belum ditulis di \"Nama proses\" pada panel.",
  "$NoLearn = @('conhost', 'powershell', 'pwsh', 'wscript', 'cscript', 'cmd', 'werfault', 'explorer', 'dllhost', 'svchost', 'consent', 'msedgewebview2', 'searchhost', 'taskmgr')",
  "function Update-ExamLearned {",
  "  $exe = $script:ExamUsed",
  "  if (-not $exe) { return }",
  "  try {",
  "    $all = @(Get-CimInstance Win32_Process -Property ProcessId, ParentProcessId, Name, ExecutablePath -ErrorAction Stop)",
  "  } catch { return }",
  "  $set = @{}",
  "  $dir = ''",
  "  if ($script:ExamDirDetect) { $dir = Get-ExamDir }",
  "  foreach ($p in $all) {",
  "    $path = [string]$p.ExecutablePath",
  "    if (-not $path) { continue }",
  "    if ($path -eq $exe -or ($dir -and $path.StartsWith((Get-DirPrefix $dir), [StringComparison]::OrdinalIgnoreCase))) { $set[[int]$p.ProcessId] = $true }",
  "  }",
  "  if ($set.Count -eq 0) { return }",
  "  $changed = $true",
  "  while ($changed) {",
  "    $changed = $false",
  "    foreach ($p in $all) {",
  "      $id = [int]$p.ProcessId",
  "      if (-not $set.ContainsKey($id) -and $set.ContainsKey([int]$p.ParentProcessId)) { $set[$id] = $true; $changed = $true }",
  "    }",
  "  }",
  "  $new = $false",
  "  foreach ($p in $all) {",
  "    if (-not $set.ContainsKey([int]$p.ProcessId)) { continue }",
  "    $n = ([string]$p.Name) -replace '\\.exe$', ''",
  "    if (-not $n -or ($NoLearn -contains $n.ToLower()) -or ($ExamLearned -contains $n)) { continue }",
  "    if ($ExamLearned.Count -ge 12) { break }",
  "    [void]$ExamLearned.Add($n)",
  "    $new = $true",
  "    Write-Log ('Nama proses Exam Browser dipelajari: ' + $n)",
  "  }",
  "  if ($new) { Save-State }",
  "}",
  "",
  "# Explorer (taskbar & desktop) sering dimatikan Exam Browser selama ujian;",
  "# setelah ditutup paksa, nyalakan lagi agar layar siswa tidak hitam.",
  "function Start-ExplorerIfMissing([string]$user) {",
  "  if (-not $user) { return $false }",
  "  try {",
  "    foreach ($p in @(Get-CimInstance Win32_Process -Filter \"Name='explorer.exe'\" -ErrorAction Stop)) {",
  "      $o = Invoke-CimMethod -InputObject $p -MethodName GetOwner",
  "      if (($o.Domain + '\\' + $o.User) -eq $user) { return $false }",
  "    }",
  "  } catch { return $false }",
  "  [void](Invoke-AsUser '' 'explorer' -Exe 'explorer.exe')",
  "  return $true",
  "}",
  "",
  "# ---------- lokasi Exam Browser ----------",
  "# Panel boleh mengisi beberapa lokasi (satu per baris). Agen mencoba berurutan;",
  "# jika tidak ada satu pun, agen mencari sendiri di komputer ini (bila diizinkan).",
  "function Get-Leaf([string]$path) { return ([string]$path -split '[\\\\/]')[-1] }",
  "",
  "function Get-ExamCandidates {",
  "  $list = @()",
  "  foreach ($c in ([string]$script:ExamPath -split \"\\r?\\n|\\|\")) {",
  "    $c = $c.Trim().Trim('\"').Trim()",
  "    if ($c) { $list += [Environment]::ExpandEnvironmentVariables($c) }",
  "  }",
  "  return $list",
  "}",
  "",
  "function Get-ExamFileNames {",
  "  $names = @()",
  "  foreach ($c in (Get-ExamCandidates)) {",
  "    $leaf = Get-Leaf $c",
  "    if ($leaf -and $leaf -like '*.exe' -and $names -notcontains $leaf) { $names += $leaf }",
  "  }",
  "  if ($names.Count -eq 0 -and $script:ExamProc) {",
  "    foreach ($n in $script:ExamProc.Split(',')) {",
  "      $n = $n.Trim()",
  "      if ($n -and $n -notmatch '[\\*\\?]') { $names += ($n + '.exe') }",
  "    }",
  "  }",
  "  return $names",
  "}",
  "",
  "function Get-UserDirs([string]$sub) {",
  "  $out = @()",
  "  try {",
  "    if (-not $env:SystemDrive) { return $out }",
  "    Get-ChildItem -Path ($env:SystemDrive + '\\Users') -Directory -ErrorAction SilentlyContinue | ForEach-Object {",
  "      $d = Join-Path $_.FullName $sub",
  "      if (Test-Path -LiteralPath $d) { $out += $d }",
  "    }",
  "  } catch {}",
  "  return $out",
  "}",
  "",
  "function Find-ExamExe {",
  "  $names = @(Get-ExamFileNames)",
  "  if ($names.Count -eq 0) { return '' }",
  "  # 1. registri App Paths",
  "  foreach ($n in $names) {",
  "    foreach ($root in @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\App Paths')) {",
  "      try {",
  "        $v = (Get-ItemProperty -Path ($root + '\\' + $n) -ErrorAction Stop).'(default)'",
  "        if ($v) { $v = $v.Trim('\"'); if (Test-Path -LiteralPath $v -PathType Leaf) { return $v } }",
  "      } catch {}",
  "    }",
  "  }",
  "  # 2. shortcut di Desktop dan Start Menu",
  "  $lnkDirs = @()",
  "  if ($env:PUBLIC) { $lnkDirs += (Join-Path $env:PUBLIC 'Desktop') }",
  "  if ($env:ProgramData) { $lnkDirs += (Join-Path $env:ProgramData 'Microsoft\\Windows\\Start Menu\\Programs') }",
  "  $lnkDirs += Get-UserDirs 'Desktop'",
  "  $lnkDirs += Get-UserDirs 'OneDrive\\Desktop'",
  "  $lnkDirs += Get-UserDirs 'AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs'",
  "  try {",
  "    $sh = New-Object -ComObject WScript.Shell",
  "    foreach ($d in $lnkDirs) {",
  "      if (-not (Test-Path -LiteralPath $d)) { continue }",
  "      foreach ($l in @(Get-ChildItem -LiteralPath $d -Filter '*.lnk' -Recurse -Depth 3 -File -ErrorAction SilentlyContinue)) {",
  "        try {",
  "          $t = [string]$sh.CreateShortcut($l.FullName).TargetPath",
  "          if ($t -and ($names -contains (Get-Leaf $t)) -and (Test-Path -LiteralPath $t -PathType Leaf)) { return $t }",
  "        } catch {}",
  "      }",
  "    }",
  "  } catch {}",
  "  # 3. folder instalasi yang umum",
  "  $roots = @()",
  "  foreach ($r in @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData)) { if ($r) { $roots += ,@($r, 4) } }",
  "  foreach ($r in (Get-UserDirs 'AppData\\Local\\Programs')) { $roots += ,@($r, 3) }",
  "  foreach ($r in (Get-UserDirs 'AppData\\Local')) { $roots += ,@($r, 2) }",
  "  foreach ($r in (Get-UserDirs 'Desktop')) { $roots += ,@($r, 3) }",
  "  foreach ($r in (Get-UserDirs 'Downloads')) { $roots += ,@($r, 2) }",
  "  $roots += ,@(($env:SystemDrive + '\\'), 1)",
  "  try {",
  "    Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' -ErrorAction SilentlyContinue | ForEach-Object {",
  "      if ($_.DeviceID -ne $env:SystemDrive) { $roots += ,@(($_.DeviceID + '\\'), 2) }",
  "    }",
  "  } catch {}",
  "  foreach ($pair in $roots) {",
  "    foreach ($n in $names) {",
  "      $f = Get-ChildItem -LiteralPath $pair[0] -Filter $n -Recurse -Depth $pair[1] -File -ErrorAction SilentlyContinue | Select-Object -First 1",
  "      if ($f) { return $f.FullName }",
  "    }",
  "  }",
  "  return ''",
  "}",
  "",
  "function Resolve-ExamPath([switch]$Force) {",
  "  $cands = @(Get-ExamCandidates)",
  "  $script:ExamTried = $cands",
  "  foreach ($c in $cands) {",
  "    if (Test-Path -LiteralPath $c -PathType Leaf) { $script:ExamUsed = $c; return $c }",
  "  }",
  "  if (-not $script:ExamAuto) { $script:ExamUsed = ''; return '' }",
  "  $names = @(Get-ExamFileNames)",
  "  if ($script:ExamFound -and ($names -contains (Get-Leaf $script:ExamFound)) -and (Test-Path -LiteralPath $script:ExamFound -PathType Leaf)) {",
  "    $script:ExamUsed = $script:ExamFound; return $script:ExamFound",
  "  }",
  "  if (-not $Force -and ((Get-Date) - $script:ExamSearchAt).TotalMinutes -lt 10) { $script:ExamUsed = ''; return '' }",
  "  $script:ExamSearchAt = Get-Date",
  "  $t0 = Get-Date",
  "  $found = Find-ExamExe",
  "  $secs = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)",
  "  if ($found) { Write-Log ('Exam Browser ditemukan otomatis: ' + $found + ' (' + $secs + ' dtk)') }",
  "  else { Write-Log ('Exam Browser tidak ditemukan (pencarian ' + $secs + ' dtk).') }",
  "  $script:ExamFound = $found",
  "  Save-State",
  "  $script:ExamUsed = $found",
  "  return $found",
  "}",
  "",
  "# Folder instalasi Exam Browser. Semua program yang berjalan dari folder ini",
  "# dianggap bagian dari Exam Browser (misalnya runningexam.exe pada ANBK),",
  "# walaupun namanya belum ditulis di \"Nama proses\".",
  "function Get-DirPrefix([string]$dir) {",
  "  if ($dir.Contains('/') -and -not $dir.Contains('\\')) { return $dir + '/' }",
  "  return $dir + '\\'",
  "}",
  "",
  "function Get-ExamDir {",
  "  $exe = $script:ExamUsed",
  "  if (-not $exe) { return '' }",
  "  $leaf = (Get-Leaf $exe).ToLower()",
  "  if (@('chrome.exe', 'msedge.exe', 'firefox.exe', 'iexplore.exe', 'opera.exe', 'brave.exe') -contains $leaf) { return '' }",
  "  $dir = ([string]$exe).Substring(0, [math]::Max(0, ([string]$exe).Length - (Get-Leaf $exe).Length)).TrimEnd('\\', '/')",
  "  if (-not $dir -or $dir -match '^[A-Za-z]:$') { return '' }",
  "  if ($env:SystemRoot -and $dir.StartsWith($env:SystemRoot, [StringComparison]::OrdinalIgnoreCase)) { return '' }",
  "  if ($dir -match '\\\\Users\\\\[^\\\\]+\\\\(Desktop|Downloads|Documents|OneDrive)$' -or $dir -match '\\\\Users\\\\[^\\\\]+$') { return '' }",
  "  foreach ($pf in @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData)) { if ($pf -and $dir -eq $pf.TrimEnd('\\')) { return '' } }",
  "  return $dir",
  "}",
  "",
  "function Get-ExamProcesses {",
  "  $ids = @{}",
  "  $out = @()",
  "  $names = @(Get-ExamNames)",
  "  if ($names.Count -gt 0) {",
  "    foreach ($p in @(Get-Process -Name $names -ErrorAction SilentlyContinue)) { if (-not $ids.ContainsKey($p.Id)) { $ids[$p.Id] = 1; $out += $p } }",
  "  }",
  "  $dir = ''",
  "  if ($script:ExamDirDetect) { $dir = Get-ExamDir }",
  "  if ($dir) {",
  "    $prefix = Get-DirPrefix $dir",
  "    $procList = $null",
  "    try {",
  "      $procList = @(Get-CimInstance Win32_Process -Property ProcessId, Name, ExecutablePath -ErrorAction Stop | ForEach-Object { @{ id = [int]$_.ProcessId; name = [string]$_.Name; path = [string]$_.ExecutablePath } })",
  "    } catch {",
  "      # cadangan bila WMI bermasalah",
  "      $procList = @(Get-Process -ErrorAction SilentlyContinue | ForEach-Object { $pp = ''; try { $pp = [string]$_.Path } catch {}; @{ id = [int]$_.Id; name = [string]$_.ProcessName; path = $pp } })",
  "    }",
  "    foreach ($c in $procList) {",
  "      $path = $c.path",
  "      if (-not $path -or -not $path.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { continue }",
  "      if ($ids.ContainsKey($c.id) -or $c.id -eq $PID) { continue }",
  "      if ($NoLearn -contains (($c.name -replace '\\.exe$', '').ToLower())) { continue }",
  "      $pr = Get-Process -Id $c.id -ErrorAction SilentlyContinue",
  "      if ($pr) { $ids[$c.id] = 1; $out += $pr }",
  "    }",
  "  }",
  "  return $out",
  "}",
  "",
  "function ConvertTo-Vbs([string]$s) {",
  "  $s = $s -replace '\"', '\"\"'",
  "  $s = $s -replace \"`r`n|`n|`r\", '\" & vbCrLf & \"'",
  "  return '\"' + $s + '\"'",
  "}",
  "",
  "# Menjalankan program di sesi pengguna yang sedang login (agen berjalan",
  "# sebagai SYSTEM sehingga tidak punya layar sendiri), lewat tugas terjadwal",
  "# sekali pakai. -Exe: program dijalankan langsung oleh Task Scheduler.",
  "# Tanpa -Exe: skrip VBS kecil ($vbsBody) dijalankan dengan wscript.",
  "function Invoke-AsUser([string]$vbsBody, [string]$tag, [switch]$Elevated, [string]$Exe = '', [string]$Arguments = '', [string]$WorkDir = '') {",
  "  $user = Get-LoggedUser",
  "  if (-not $user) { throw 'Tidak ada pengguna yang sedang login di komputer ini.' }",
  "  $name = 'PL-' + $tag + '-' + ([guid]::NewGuid().ToString('N').Substring(0, 8))",
  "  $script:LastTask = $name",
  "  if (-not (Get-Command Register-ScheduledTask -ErrorAction SilentlyContinue)) {",
  "    # di luar Windows (hanya untuk pengujian): jalankan langsung",
  "    if (-not $Exe) { throw 'Task Scheduler tidak tersedia di komputer ini.' }",
  "    $sp = @{ FilePath = $Exe; PassThru = $true }",
  "    if ($Arguments) { $sp.ArgumentList = $Arguments }",
  "    if ($WorkDir) { $sp.WorkingDirectory = $WorkDir }",
  "    $script:TestProcs[$name] = Start-Process @sp -ErrorAction Stop",
  "    return $user",
  "  }",
  "  if ($Exe) {",
  "    $ap = @{ Execute = $Exe }",
  "    if ($Arguments) { $ap.Argument = $Arguments }",
  "    if ($WorkDir) { $ap.WorkingDirectory = $WorkDir }",
  "    $act = New-ScheduledTaskAction @ap",
  "  } else {",
  "    $file = Join-Path $RunDir ($name + '.vbs')",
  "    [IO.File]::WriteAllText($file, $vbsBody, [Text.Encoding]::Unicode)",
  "    $act = New-ScheduledTaskAction -Execute 'wscript.exe' -Argument ('//Nologo \"' + $file + '\"')",
  "  }",
  "  # RunLevel Highest = berjalan sebagai Administrator tanpa jendela UAC (jika akunnya admin)",
  "  $lvl = 'Limited'",
  "  if ($Elevated) { $lvl = 'Highest' }",
  "  $pri = New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel $lvl",
  "  # Priority 4 = prioritas normal (bawaan Task Scheduler 7 = di bawah normal, ikut menurun ke Exam Browser)",
  "  $set = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances Parallel -Priority 4",
  "  Register-ScheduledTask -TaskName $name -TaskPath $TaskPath -Action $act -Principal $pri -Settings $set -Force -ErrorAction Stop | Out-Null",
  "  Start-ScheduledTask -TaskName $name -TaskPath $TaskPath -ErrorAction Stop",
  "  return $user",
  "}",
  "",
  "# hasil terakhir tugas sekali pakai (kode Windows); $null bila tidak diketahui",
  "function Get-TaskResult([string]$name) {",
  "  if (-not $name) { return $null }",
  "  if ($script:TestProcs.ContainsKey($name)) {",
  "    $tp = $script:TestProcs[$name]",
  "    if (-not $tp.HasExited) { return [int64]267009 }",
  "    return [int64]$tp.ExitCode",
  "  }",
  "  try { return [int64](Get-ScheduledTaskInfo -TaskName $name -TaskPath $TaskPath -ErrorAction Stop).LastTaskResult } catch { return $null }",
  "}",
  "",
  "# kode gagal-jalan dari Task Scheduler -> penjelasan (kosong = bukan kegagalan membuka program)",
  "function Get-LaunchError($code) {",
  "  if ($null -eq $code) { return '' }",
  "  $c = [int64]$code",
  "  if ($c -lt 0) { $c += 4294967296 }",
  "  if ($c -lt 2147942400 -or $c -gt 2148007935) { return '' }   # hanya 0x8007xxxx",
  "  $hex = '0x' + $c.ToString('X8')",
  "  switch ($c) {",
  "    2147942402 { return ('file program tidak ditemukan (' + $hex + ')') }",
  "    2147942403 { return ('folder tidak ditemukan (' + $hex + ')') }",
  "    2147942405 { return ('akses ditolak (' + $hex + ')') }",
  "    2147942667 { return ('folder kerja tidak valid (' + $hex + ')') }",
  "    2147943140 { return ('program meminta hak Administrator (' + $hex + ')') }",
  "    2147942593 { return ('file bukan program Windows yang valid (' + $hex + ')') }",
  "  }",
  "  return ('kode Windows ' + $hex)",
  "}",
  "",
  "# Windows Script Host (VBScript) tersedia? Bisa dimatikan kebijakan sekolah",
  "# atau tidak terpasang di Windows terbaru.",
  "function Test-Vbs {",
  "  if (-not $env:SystemRoot) { return $false }",
  "  if (-not (Test-Path -LiteralPath (Join-Path $env:SystemRoot 'System32\\vbscript.dll'))) { return $false }",
  "  if (-not (Test-Path -LiteralPath (Join-Path $env:SystemRoot 'System32\\wscript.exe'))) { return $false }",
  "  try {",
  "    $v = (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows Script Host\\Settings' -ErrorAction Stop).Enabled",
  "    if ($null -ne $v -and [string]$v -eq '0') { return $false }",
  "  } catch {}",
  "  return $true",
  "}",
  "",
  "function Get-ParentDir([string]$path) {",
  "  $leaf = Get-Leaf $path",
  "  return ([string]$path).Substring(0, [math]::Max(0, ([string]$path).Length - $leaf.Length)).TrimEnd('\\', '/')",
  "}",
  "",
  "# Jalankan autopilot.ps1 (klik otomatis / shortcut keluar) di sesi pengguna.",
  "# Pengaturan ditulis ke file JSON agar baris perintahnya selalu sederhana.",
  "# Mengembalikan lokasi file log autopilot (dibaca agen untuk laporan).",
  "function Start-Autopilot([hashtable]$job, [string]$tag, [switch]$Quiet) {",
  "  Update-Autopilot",
  "  $user = Get-LoggedUser",
  "  if (-not $user) { throw 'Tidak ada pengguna yang sedang login di komputer ini.' }",
  "  $base = 'PL-' + $tag + '-' + ([guid]::NewGuid().ToString('N').Substring(0, 8))",
  "  $jobFile = Join-Path $RunDir ($base + '.json')",
  "  $logFile = Join-Path $RunDir ($base + '.log')",
  "  $job.log = $logFile",
  "  [IO.File]::WriteAllText($jobFile, (ConvertTo-Json -InputObject $job -Depth 4 -Compress), (New-Object Text.UTF8Encoding($true)))",
  "  [IO.File]::WriteAllText($logFile, '', (New-Object Text.UTF8Encoding($false)))",
  "  # log boleh ditulis pengguna (folder agen hanya bisa dibaca pengguna biasa)",
  "  if ($IsWin) { try { & icacls.exe $logFile /grant ($user + ':(M)') | Out-Null } catch {} }",
  "  $argStr = '-NoProfile -ExecutionPolicy Bypass '",
  "  if ($IsWin) { $argStr += '-WindowStyle Hidden ' }",
  "  $argStr += '-File \"' + $AutopilotFile + '\" -Job \"' + $jobFile + '\"'",
  "  if ($Quiet -and (Test-Vbs)) {",
  "    # lewat VBS agar jendela PowerShell sama sekali tidak muncul (tidak mengganggu fokus Exam Browser)",
  "    $vbs = 'CreateObject(\"WScript.Shell\").Run ' + (ConvertTo-Vbs ('\"' + $PsExe + '\" ' + $argStr)) + ', 0, False'",
  "    [void](Invoke-AsUser $vbs $tag -Elevated)",
  "  } else {",
  "    [void](Invoke-AsUser '' $tag -Elevated -Exe $PsExe -Arguments $argStr -WorkDir $RunDir)",
  "  }",
  "  return $logFile",
  "}",
  "",
  "function Read-RunLog([string]$path, [int]$n = 5) {",
  "  try {",
  "    if ($path -and (Test-Path -LiteralPath $path)) {",
  "      return @(Get-Content -LiteralPath $path -Tail $n -Encoding UTF8 -ErrorAction Stop | Where-Object { ([string]$_).Trim() })",
  "    }",
  "  } catch {}",
  "  return @()",
  "}",
  "",
  "# Buka file Exam Browser di sesi pengguna.",
  "#  - .exe + Administrator (atau tanpa VBScript): dijalankan langsung oleh Task Scheduler",
  "#  - selain itu lewat shell Windows (sama seperti klik dua kali; UAC muncul bila perlu)",
  "function Start-ExamExe([string]$exe, [string]$wd, [switch]$Shell) {",
  "  $isExe = ($exe -match '\\.exe$') -or -not $IsWin",
  "  $vbsOk = Test-Vbs",
  "  if (-not $Shell -and $isExe -and ($script:ExamElevate -or -not $vbsOk)) {",
  "    $u = Invoke-AsUser '' 'exam' -Elevated:$script:ExamElevate -Exe $exe -Arguments $script:ExamArgs -WorkDir $wd",
  "    return @{ user = $u; task = $script:LastTask; how = 'langsung' }",
  "  }",
  "  if ($vbsOk) {",
  "    $cmd = '\"' + $exe + '\"'",
  "    if ($script:ExamArgs) { $cmd += ' ' + $script:ExamArgs }",
  "    $vbs = 'Set sh = CreateObject(\"WScript.Shell\")' + \"`r`n\"",
  "    if ($wd) { $vbs += 'sh.CurrentDirectory = ' + (ConvertTo-Vbs $wd) + \"`r`n\" }",
  "    $vbs += 'sh.Run ' + (ConvertTo-Vbs $cmd) + ', 3, False'",
  "    $u = Invoke-AsUser $vbs 'exam' -Elevated:$script:ExamElevate",
  "    return @{ user = $u; task = $script:LastTask; how = 'shell' }",
  "  }",
  "  # tanpa VBScript: minta Explorer membukanya (setara klik dua kali)",
  "  $u = Invoke-AsUser '' 'exam' -Exe 'explorer.exe' -Arguments ('\"' + $exe + '\"')",
  "  return @{ user = $u; task = $script:LastTask; how = 'explorer' }",
  "}",
  "",
  "function Test-UserAdmin([string]$user) {",
  "  try {",
  "    $m = @(Get-LocalGroupMember -SID 'S-1-5-32-544' -ErrorAction Stop | ForEach-Object { [string]$_.Name })",
  "    return ($m -contains $user)",
  "  } catch { return $null }",
  "}",
  "",
  "function ConvertTo-B64([string]$s) { return [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes([string]$s)) }",
  "",
  "# autopilot.ps1 (klik otomatis jendela pembuka Exam Browser) diunduh dari backend bila belum ada/versi lama",
  "function Update-Autopilot {",
  "  $head = '# ProktorLab Autopilot ' + $AutopilotVersion",
  "  if (Test-Path -LiteralPath $AutopilotFile) {",
  "    $first = (Get-Content -LiteralPath $AutopilotFile -TotalCount 1 -ErrorAction SilentlyContinue)",
  "    if ($first -eq $head) { return }",
  "  }",
  "  $sep = '?'",
  "  if ($Server.Contains('?')) { $sep = '&' }",
  "  $resp = Invoke-WebRequest -Uri ($Server + $sep + 'f=autopilot&k=' + [uri]::EscapeDataString($Key)) -UseBasicParsing -TimeoutSec 60",
  "  $code = [string]$resp.Content",
  "  if (-not $code.StartsWith('# ProktorLab Autopilot')) { throw 'Unduhan autopilot tidak valid. Perbarui Code.gs dan Agen.gs di Apps Script.' }",
  "  [IO.File]::WriteAllText($AutopilotFile, $code, (New-Object Text.UTF8Encoding($true)))",
  "  Write-Log 'autopilot.ps1 diperbarui.'",
  "}",
  "",
  "function Clear-RunTasks {",
  "  try {",
  "    Get-ScheduledTask -TaskPath $TaskPath -ErrorAction SilentlyContinue |",
  "      Where-Object { $_.State -ne 'Running' } |",
  "      ForEach-Object { Unregister-ScheduledTask -TaskName $_.TaskName -TaskPath $_.TaskPath -Confirm:$false -ErrorAction SilentlyContinue }",
  "    Get-ChildItem $RunDir -File -ErrorAction SilentlyContinue |",
  "      Where-Object { $_.Extension -in @('.vbs', '.json', '.log') -and $_.LastWriteTime -lt (Get-Date).AddMinutes(-60) } |",
  "      Remove-Item -Force -ErrorAction SilentlyContinue",
  "  } catch {}",
  "}",
  "",
  "function Send-Wol($list) {",
  "  $udp = New-Object System.Net.Sockets.UdpClient",
  "  $udp.EnableBroadcast = $true",
  "  $count = 0",
  "  try {",
  "    foreach ($t in @($list)) {",
  "      if (-not $t) { continue }",
  "      $hex = ([string]$t.m) -replace '[^0-9A-Fa-f]', ''",
  "      if ($hex.Length -ne 12) { continue }",
  "      $mac = New-Object byte[] 6",
  "      for ($x = 0; $x -lt 6; $x++) { $mac[$x] = [Convert]::ToByte($hex.Substring($x * 2, 2), 16) }",
  "      $pkt = New-Object byte[] 102",
  "      for ($x = 0; $x -lt 6; $x++) { $pkt[$x] = 0xFF }",
  "      for ($r = 0; $r -lt 16; $r++) { for ($x = 0; $x -lt 6; $x++) { $pkt[6 + $r * 6 + $x] = $mac[$x] } }",
  "      $dests = @('255.255.255.255')",
  "      if ($t.b) { $dests += [string]$t.b }",
  "      for ($round = 0; $round -lt 3; $round++) {",
  "        foreach ($d in $dests) {",
  "          foreach ($port in @(9, 7)) {",
  "            try { [void]$udp.Send($pkt, $pkt.Length, $d, $port) } catch {}",
  "          }",
  "        }",
  "        Start-Sleep -Milliseconds 120",
  "      }",
  "      $count++",
  "    }",
  "  } finally { $udp.Close() }",
  "  return $count",
  "}",
  "",
  "function Add-Result([string]$jobId, [string]$status, [string]$output) {",
  "  if ($output.Length -gt 2800) { $output = $output.Substring(0, 2800) }",
  "  [void]$Results.Add(@{ id = $jobId; s = $status; o = $output; t = (Get-ServerNow) })",
  "  Save-State",
  "  $script:NextCheck = Get-Date",
  "}",
  "",
  "function Invoke-Api($body) {",
  "  $json = ConvertTo-Json -InputObject $body -Depth 6 -Compress",
  "  $bytes = [Text.Encoding]::UTF8.GetBytes($json)",
  "  return Invoke-RestMethod -Uri $Server -Method Post -Body $bytes -ContentType 'text/plain; charset=utf-8' -TimeoutSec 40 -UseBasicParsing",
  "}",
  "",
  "function Invoke-Checkin {",
  "  if (((Get-Date) - $script:InfoAt).TotalSeconds -gt 60 -or -not $script:Info) {",
  "    $script:Info = Get-Info",
  "    $script:InfoAt = Get-Date",
  "    if ($script:ExamSig) { [void](Resolve-ExamPath); Update-ExamLearned }",
  "  }",
  "  $sendResults = @($Results.ToArray())",
  "  $sendAcks = @($Acks.ToArray())",
  "  $examProcs = @(Get-ExamProcesses)",
  "  $examRunning = ($examProcs.Count -gt 0)",
  "  $examNames = @($examProcs | ForEach-Object { $_.ProcessName } | Sort-Object -Unique | Select-Object -First 6)",
  "  $body = @{",
  "    k = $Key; a = 'checkin'; id = $Id; ver = $AgentVersion; grp = $Group",
  "    user = (Get-LoggedUser); exam = $examRunning",
  "    ip = $script:Info.ip; mac = $script:Info.mac; bc = $script:Info.bc; os = $script:Info.os",
  "    results = $sendResults; acks = $sendAcks",
  "    exp = $script:ExamUsed; eok = [bool]$script:ExamUsed; ecfg = [bool]$script:ExamSig",
  "    epl = ($examNames -join ','); edir = $(if ($script:ExamDirDetect) { Get-ExamDir } else { '' })",
  "  }",
  "  $t0 = Get-NowMs",
  "  $res = Invoke-Api $body",
  "  $t1 = Get-NowMs",
  "  if (-not $res -or -not $res.ok) {",
  "    $err = 'respon tidak dikenal'",
  "    if ($res -and $res.error) { $err = [string]$res.error }",
  "    throw ('Server menolak: ' + $err)",
  "  }",
  "  # hapus hasil & ack yang sudah terkirim",
  "  foreach ($r in $sendResults) { $Results.Remove($r) }",
  "  foreach ($a in $sendAcks) { $Acks.Remove($a) }",
  "  if ($sendResults.Count -gt 0) { Save-State }",
  "",
  "  $script:Offset = [double]$res.now - (($t0 + $t1) / 2)",
  "  if ($res.interval) { $script:Interval = [math]::Max(3, [int]$res.interval) }",
  "  if ($res.cfg) {",
  "    $script:ExamPath = [string]$res.cfg.examPath",
  "    $script:ExamArgs = [string]$res.cfg.examArgs",
  "    $script:ExamProc = [string]$res.cfg.examProc",
  "    $script:ExamAuto = ($res.cfg.examAuto -ne $false)",
  "    $script:ExamElevate = ($res.cfg.examElevate -eq $true)",
  "    $script:ExamClick = ($res.cfg.examClick -eq $true)",
  "    $script:ExamRules = [string]$res.cfg.examRules",
  "    $script:ExamCloseKeys = [string]$res.cfg.examCloseKeys",
  "    $script:ExamDirDetect = ($res.cfg.examDirDetect -ne $false)",
  "    $sig = $script:ExamPath + '|' + $script:ExamProc + '|' + $script:ExamAuto",
  "    if ($sig -ne $script:ExamSig) {",
  "      # pengaturan lokasi berubah: cek ulang segera pada laporan berikutnya",
  "      if ($script:ExamSig -and $ExamLearned.Count) { $ExamLearned.Clear(); Save-State }",
  "      $script:ExamSig = $sig",
  "      $script:ExamSearchAt = [datetime]::MinValue",
  "      [void](Resolve-ExamPath)",
  "      $script:NextCheck = Get-Date",
  "    }",
  "  }",
  "",
  "  # sinkronkan antrean perintah",
  "  $seen = @{}",
  "  foreach ($j in @($res.jobs)) {",
  "    if (-not $j -or -not $j.id) { continue }",
  "    $jid = [string]$j.id",
  "    $seen[$jid] = $true",
  "    if ($Done -contains $jid) {",
  "      $pending = $false",
  "      foreach ($r in $Results) { if ($r.id -eq $jid) { $pending = $true } }",
  "      if (-not $pending) { Add-Result $jid 'ok' 'Sudah dijalankan sebelumnya.' }",
  "      continue",
  "    }",
  "    if (-not $Jobs.ContainsKey($jid)) {",
  "      $Jobs[$jid] = $j",
  "      [void]$Acks.Add($jid)",
  "      Write-Log ('Perintah diterima: ' + $j.a + ' (' + $jid + ')')",
  "    }",
  "  }",
  "  foreach ($k in @($Jobs.Keys)) { if (-not $seen.ContainsKey($k)) { $Jobs.Remove($k) } }",
  "}",
  "",
  "function Invoke-Job($j) {",
  "  $jid = [string]$j.id",
  "  [void]$Done.Add($jid)",
  "  Save-State",
  "  $p = $j.p",
  "  Write-Log ('Menjalankan ' + $j.a + ' (' + $jid + ')')",
  "  try {",
  "    switch ([string]$j.a) {",
  "      'run_exam' {",
  "        if (-not $script:ExamPath -and -not $script:ExamProc) { throw 'Lokasi Exam Browser belum diatur di panel (Pustaka Skrip).' }",
  "        $running = @(Get-ExamProcesses)",
  "        if ($running.Count -gt 0) {",
  "          $rn = @($running | ForEach-Object { $_.ProcessName } | Sort-Object -Unique) -join ', '",
  "          Add-Result $jid 'ok' ('Exam Browser sudah berjalan (proses: ' + $rn + '). Untuk membuka ulang, jalankan #Close ExamBrowser dulu.')",
  "          return",
  "        }",
  "        $exe = Resolve-ExamPath -Force",
  "        $script:NextCheck = Get-Date",
  "        if (-not $exe) {",
  "          $msg = 'Exam Browser tidak ditemukan di komputer ini.'",
  "          if ($script:ExamTried.Count) { $msg += ' Sudah dicek: ' + ($script:ExamTried -join '; ') + '.' }",
  "          if ($script:ExamAuto) { $msg += ' Pencarian otomatis juga tidak menemukan.' }",
  "          $msg += ' Atur lokasi khusus komputer ini di panel (menu Endpoint).'",
  "          throw $msg",
  "        }",
  "        $wd = Get-ParentDir $exe",
  "        $mode = @()",
  "        $warn = @()",
  "        # 1) klik otomatis disiapkan lebih dulu, lalu Exam Browser dibuka terpisah:",
  "        #    bila klik otomatis bermasalah, Exam Browser tetap terbuka.",
  "        $apLog = ''",
  "        if ($script:ExamClick -and $script:ExamRules.Trim()) {",
  "          try {",
  "            $names = ([string]$script:ExamProc + ',' + ((Get-Leaf $exe) -replace '\\.exe$', '')).Trim(',')",
  "            $dir = ''",
  "            if ($script:ExamDirDetect) { $dir = Get-ExamDir }",
  "            $apLog = Start-Autopilot @{ mode = 'open'; rules = $script:ExamRules; names = $names; dir = $dir; timeout = 150 } 'klik'",
  "            $mode += 'klik otomatis'",
  "          } catch { $warn += ('Klik otomatis tidak aktif: ' + $_.Exception.Message) }",
  "        }",
  "        # 2) buka Exam Browser",
  "        $launch = Start-ExamExe $exe $wd",
  "        $u = $launch.user",
  "        if ($script:ExamElevate) { $mode += 'Administrator' }",
  "        $ok = $false",
  "        $launchErr = ''",
  "        $retried = $false",
  "        for ($w = 0; $w -lt 50; $w++) {",
  "          Start-Sleep -Milliseconds 500",
  "          if ($w % 4 -eq 3) { Update-ExamLearned }",
  "          if (@(Get-ExamProcesses).Count -gt 0) { $ok = $true; break }",
  "          if ($w -ge 2 -and $w % 2 -eq 0 -and $launch.how -ne 'shell') {",
  "            $launchErr = Get-LaunchError (Get-TaskResult $launch.task)",
  "            if ($launchErr -and -not $retried) {",
  "              # cara langsung ditolak Windows: ulangi lewat shell (seperti klik dua kali)",
  "              $warn += ('Cara langsung gagal (' + $launchErr + '), dicoba lewat shell Windows.')",
  "              $retried = $true",
  "              $launchErr = ''",
  "              try { $launch = Start-ExamExe $exe $wd -Shell } catch { $launchErr = [string]$_.Exception.Message; break }",
  "            } elseif ($launchErr) { break }",
  "          }",
  "        }",
  "        if ($script:ExamElevate -and ((Test-UserAdmin $u) -eq $false)) {",
  "          $warn += ('Akun ' + $u + ' bukan Administrator, jendela UAC akan meminta kata sandi admin.')",
  "        }",
  "        $note = ''",
  "        if ($mode.Count) { $note = ' [' + ($mode -join ', ') + ']' }",
  "        if ($warn.Count) { $note += ' ' + ($warn -join ' ') }",
  "        if ($ok) {",
  "          Add-Result $jid 'ok' ('Exam Browser dibuka untuk ' + $u + ' (' + $exe + ').' + $note)",
  "        } else {",
  "          if ($launchErr) { $msg = 'Exam Browser gagal dibuka: ' + $launchErr + '. File: ' + $exe + '.' + $note }",
  "          else {",
  "            $msg = 'Exam Browser tidak terlihat berjalan 25 detik setelah dibuka untuk ' + $u + ' (' + $exe + ').' + $note",
  "            $rc = Get-TaskResult $launch.task",
  "            if ($launch.how -eq 'langsung' -and $null -ne $rc -and $rc -ne 267009 -and $rc -ne 267011) { $msg += ' Program langsung tertutup (kode keluar ' + $rc + ').' }",
  "          }",
  "          $lines = @(Read-RunLog $apLog 4)",
  "          if ($lines.Count) { $msg += \"`nLog klik otomatis:`n\" + ($lines -join \"`n\") }",
  "          $msg += \"`nBila di layar siswa Exam Browser sebenarnya terbuka, jalankan #Cek Proses lalu isi Nama proses di Pustaka Skrip.\"",
  "          Add-Result $jid 'err' $msg",
  "        }",
  "      }",
  "      'close_exam' {",
  "        Update-ExamLearned",
  "        $names = @(Get-ExamNames)",
  "        $procs = @(Get-ExamProcesses)",
  "        if ($procs.Count -eq 0) {",
  "          Add-Result $jid 'ok' ('Tidak ada Exam Browser yang berjalan (dicari: ' + ($names -join ', ') + '). Jika sebenarnya terbuka, isi Nama proses di Pustaka Skrip sesuai Task Manager > Details.')",
  "          return",
  "        }",
  "        $user = Get-LoggedUser",
  "        $how = ''",
  "        # 1) cara resmi: tekan shortcut keluar Exam Browser (misalnya Ctrl+C+B+L) di layar siswa",
  "        if ($script:ExamCloseKeys.Trim() -and $user) {",
  "          try {",
  "            $dir = ''",
  "            if ($script:ExamDirDetect) { $dir = Get-ExamDir }",
  "            [void](Start-Autopilot @{ mode = 'close'; keys = $script:ExamCloseKeys; rules = '* > Yes/Ya/OK/Oke'; names = ($names -join ','); dir = $dir; timeout = 40 } 'close' -Quiet)",
  "            for ($w = 0; $w -lt 40; $w++) {",
  "              Start-Sleep -Milliseconds 500",
  "              if (@(Get-ExamProcesses).Count -eq 0) { $how = 'shortcut ' + (($script:ExamCloseKeys -split \"\\r?\\n\" | Where-Object { $_.Trim() }) -join ' / '); break }",
  "            }",
  "          } catch { Write-Log ('Shortcut keluar gagal: ' + $_.Exception.Message) }",
  "        }",
  "        # 2) cadangan: hentikan paksa proses",
  "        $left = 0",
  "        if (-not $how) {",
  "          $rest = @(Get-ExamProcesses)",
  "          for ($w = 0; $w -lt 8 -and $rest.Count -gt 0; $w++) {",
  "            $rest | Stop-Process -Force -ErrorAction SilentlyContinue",
  "            Start-Sleep -Milliseconds 500",
  "            $rest = @(Get-ExamProcesses)",
  "          }",
  "          $left = $rest.Count",
  "          if ($left -eq 0) { $how = 'dihentikan paksa' }",
  "        }",
  "        $extra = ''",
  "        if ($how) {",
  "          Start-Sleep -Seconds 2",
  "          try { if (Start-ExplorerIfMissing $user) { $extra = ' Explorer (taskbar) dinyalakan kembali.' } } catch {}",
  "          Add-Result $jid 'ok' ('Exam Browser ditutup (' + $how + ').' + $extra)",
  "        } else {",
  "          Add-Result $jid 'err' ('Masih ada ' + $left + ' proses Exam Browser yang belum tertutup.')",
  "        }",
  "      }",
  "      'wol' {",
  "        $n = Send-Wol $p.macs",
  "        if ($n -gt 0) { Add-Result $jid 'ok' ('Magic packet dikirim oleh ' + $Id + ' ke ' + $n + ' komputer.') }",
  "        else { Add-Result $jid 'err' 'Tidak ada alamat MAC yang valid.' }",
  "      }",
  "      'shutdown' {",
  "        Add-Result $jid 'ok' 'Komputer dimatikan.'",
  "        try { Invoke-Checkin } catch {}",
  "        & shutdown.exe /s /f /t 5 /c \"Komputer dimatikan oleh Proktor (ProktorLab).\" | Out-Null",
  "      }",
  "      'restart' {",
  "        Add-Result $jid 'ok' 'Komputer dimulai ulang.'",
  "        try { Invoke-Checkin } catch {}",
  "        & shutdown.exe /r /f /t 5 /c \"Komputer dimulai ulang oleh Proktor (ProktorLab).\" | Out-Null",
  "      }",
  "      'logoff' {",
  "        $u = Invoke-AsUser '' 'logoff' -Exe 'shutdown.exe' -Arguments '/l /f'",
  "        Add-Result $jid 'ok' ('Log off dikirim ke ' + $u + '.')",
  "      }",
  "      'lock' {",
  "        $u = Invoke-AsUser '' 'lock' -Exe 'rundll32.exe' -Arguments 'user32.dll,LockWorkStation'",
  "        Add-Result $jid 'ok' ('Layar dikunci (' + $u + ').')",
  "      }",
  "      'message' {",
  "        $text = [string]$p.text",
  "        if (-not $text) { throw 'Isi pesan kosong.' }",
  "        if (Test-Vbs) {",
  "          $vbs = 'CreateObject(\"WScript.Shell\").Popup ' + (ConvertTo-Vbs $text) + ', 0, \"Pesan dari Proktor\", 4160'",
  "          $u = Invoke-AsUser $vbs 'msg'",
  "        } else {",
  "          # tanpa VBScript: pakai msg.exe bawaan Windows",
  "          $u = Get-LoggedUser",
  "          & msg.exe '*' '/TIME:0' $text 2>&1 | Out-Null",
  "        }",
  "        Add-Result $jid 'ok' ('Pesan ditampilkan ke ' + $u + '.')",
  "      }",
  "      'list_procs' {",
  "        # daftar program yang berjalan di sesi pengguna (bukan bawaan Windows)",
  "        $user = Get-LoggedUser",
  "        $exam = @{}",
  "        foreach ($e in @(Get-ExamProcesses)) { $exam[[int]$e.Id] = 1 }",
  "        $sys = [string]$env:SystemRoot",
  "        $rows = @{}",
  "        $plist = $null",
  "        try {",
  "          $plist = @(Get-CimInstance Win32_Process -Property ProcessId, Name, ExecutablePath, SessionId -ErrorAction Stop |",
  "            ForEach-Object { @{ id = [int]$_.ProcessId; name = [string]$_.Name; path = [string]$_.ExecutablePath; sid = [int]$_.SessionId } })",
  "        } catch {",
  "          $plist = @(Get-Process -ErrorAction SilentlyContinue | ForEach-Object {",
  "            $pp = ''; try { $pp = [string]$_.Path } catch {}",
  "            @{ id = [int]$_.Id; name = ([string]$_.ProcessName + '.exe'); path = $pp; sid = [int]$_.SessionId } })",
  "        }",
  "        foreach ($c in $plist) {",
  "          if ($c.sid -eq 0 -and $env:SystemRoot) { continue }",
  "          $path = $c.path",
  "          if (-not $path) { continue }",
  "          if ($sys -and $path.StartsWith($sys, [StringComparison]::OrdinalIgnoreCase)) { continue }",
  "          if ($path.StartsWith($Base, [StringComparison]::OrdinalIgnoreCase)) { continue }",
  "          $k = $path.ToLower()",
  "          if ($rows.ContainsKey($k)) { if ($exam.ContainsKey($c.id)) { $rows[$k].exam = $true }; continue }",
  "          $rows[$k] = @{ name = $c.name; path = $path; exam = $exam.ContainsKey($c.id) }",
  "        }",
  "        $lines = @()",
  "        foreach ($r in ($rows.Values | Sort-Object @{ e = { -not $_.exam } }, @{ e = { $_.name } })) {",
  "          $mark = ''",
  "          if ($r.exam) { $mark = ' [EXAM]' }",
  "          $lines += ($r.name + $mark + ' - ' + $r.path)",
  "        }",
  "        $head = 'Pengguna: ' + $user + '. Folder Exam Browser: ' + (Get-ExamDir) + '. Nama proses dikenali: ' + ((Get-ExamNames) -join ', ') + '.'",
  "        if ($lines.Count -eq 0) { Add-Result $jid 'ok' ($head + \"`nTidak ada program pengguna yang berjalan.\") }",
  "        else { Add-Result $jid 'ok' ($head + \"`n\" + (($lines | Select-Object -First 40) -join \"`n\")) }",
  "      }",
  "      'open_url' {",
  "        $url = [string]$p.url",
  "        if ($url -notmatch '^https?://') { throw 'URL harus diawali http:// atau https://' }",
  "        $u = Invoke-AsUser '' 'url' -Exe 'explorer.exe' -Arguments ('\"' + $url + '\"')",
  "        Add-Result $jid 'ok' ('Situs dibuka untuk ' + $u + '.')",
  "      }",
  "      'update_agent' {",
  "        $sep = '?'",
  "        if ($Server.Contains('?')) { $sep = '&' }",
  "        $resp = Invoke-WebRequest -Uri ($Server + $sep + 'f=agent&k=' + [uri]::EscapeDataString($Key)) -UseBasicParsing -TimeoutSec 60",
  "        $code = [string]$resp.Content",
  "        if (-not $code.StartsWith('# ProktorLab Agent')) { throw 'Unduhan agen tidak valid.' }",
  "        $target = Join-Path $Base 'agent.ps1'",
  "        [IO.File]::WriteAllText($target, $code, (New-Object Text.UTF8Encoding($true)))",
  "        try { Remove-Item -LiteralPath $AutopilotFile -Force -ErrorAction SilentlyContinue } catch {}",
  "        Add-Result $jid 'ok' 'Agen diperbarui, memulai ulang agen...'",
  "        try { Invoke-Checkin } catch {}",
  "        $script:Restart = $true",
  "      }",
  "      default { throw ('Aksi tidak dikenal: ' + $j.a) }",
  "    }",
  "  } catch {",
  "    Add-Result $jid 'err' ([string]$_.Exception.Message)",
  "    Write-Log ('Gagal ' + $j.a + ': ' + $_.Exception.Message)",
  "  }",
  "}",
  "",
  "function Invoke-DueJobs {",
  "  if ($Jobs.Count -eq 0) { return }",
  "  $now = Get-ServerNow",
  "  $due = @($Jobs.Values | Where-Object { [double]$_.at -le $now } | Sort-Object { [double]$_.at })",
  "  foreach ($j in $due) {",
  "    $Jobs.Remove([string]$j.id)",
  "    if ([double]$j.dl -lt $now) {",
  "      [void]$Done.Add([string]$j.id)",
  "      Add-Result ([string]$j.id) 'err' 'Kedaluwarsa: melewati batas waktu penyelesaian.'",
  "      continue",
  "    }",
  "    Invoke-Job $j",
  "    if ($script:Restart) { return }",
  "  }",
  "}",
  "",
  "# ---------------- loop utama ----------------",
  "Load-State",
  "Write-Log ('Agen v' + $AgentVersion + ' mulai. Server: ' + $Server)",
  "try {",
  "  while (-not $script:Restart) {",
  "    if ((Get-Date) -ge $NextCheck) {",
  "      try {",
  "        Invoke-Checkin",
  "        $FailCount = 0",
  "        $NextCheck = (Get-Date).AddSeconds($Interval)",
  "      } catch {",
  "        $FailCount++",
  "        $wait = [math]::Min(60, 5 * $FailCount)",
  "        if ($FailCount -le 3 -or $FailCount % 20 -eq 0) { Write-Log ('Gagal lapor ke server: ' + $_.Exception.Message) }",
  "        $NextCheck = (Get-Date).AddSeconds($wait)",
  "      }",
  "    }",
  "    Invoke-DueJobs",
  "    if ((Get-Date) -ge $NextClean) { Clear-RunTasks; $NextClean = (Get-Date).AddSeconds(60) }",
  "    Start-Sleep -Milliseconds 500",
  "  }",
  "} finally {",
  "  try { $Mutex.ReleaseMutex() } catch {}",
  "  if ($script:Restart) {",
  "    # tunggu proses ini selesai, lalu jalankan ulang tugas terjadwal agen",
  "    Write-Log 'Memulai ulang agen setelah pembaruan.'",
  "    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c ping -n 5 127.0.0.1 >nul & schtasks /run /tn \"ProktorLab Agent\" >nul' -WindowStyle Hidden",
  "  }",
  "}"
].join('\n');


/**
 * Agen.gs - kode PowerShell agen ProktorLab.
 * Disimpan sebagai teks agar bisa diunduh oleh komputer lab.
 * Tidak perlu diubah.
 */

// Kode agen yang berjalan di tiap komputer lab
var AGENT_PS1 = [
  "# ProktorLab Agent",
  "# ---------------------------------------------------------------",
  "# Agen ini berjalan otomatis sebagai SYSTEM lewat Task Scheduler",
  "# (\"ProktorLab Agent\"). Tugasnya: melapor ke Panel Proktor setiap",
  "# beberapa detik dan menjalankan perintah dari panel (buka/tutup",
  "# Exam Browser, Wake on LAN, shutdown, restart, dll).",
  "# Jangan diedit manual; perbarui lewat panel (#Perbarui Agen).",
  "# ---------------------------------------------------------------",
  "$AgentVersion = '1.1.0'",
  "$ErrorActionPreference = 'Continue'",
  "$ProgressPreference = 'SilentlyContinue'",
  "try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}",
  "",
  "$Base      = Join-Path $env:ProgramData 'ProktorLab'",
  "$CfgFile   = Join-Path $Base 'config.json'",
  "$StateFile = Join-Path $Base 'state.json'",
  "$LogFile   = Join-Path $Base 'agent.log'",
  "$RunDir    = Join-Path $Base 'run'",
  "$TaskPath  = '\\ProktorLab\\Run\\'",
  "",
  "function Write-Log([string]$msg) {",
  "  try {",
  "    $line = (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + '  ' + $msg",
  "    Add-Content -Path $LogFile -Value $line -Encoding UTF8",
  "    if ((Get-Item $LogFile).Length -gt 1MB) { Move-Item $LogFile ($LogFile + '.old') -Force }",
  "  } catch {}",
  "}",
  "",
  "# ---------- hanya boleh ada satu agen yang berjalan ----------",
  "$Mutex = New-Object System.Threading.Mutex($false, 'Global\\ProktorLabAgent')",
  "$HasMutex = $false",
  "try { $HasMutex = $Mutex.WaitOne(25000) } catch [System.Threading.AbandonedMutexException] { $HasMutex = $true }",
  "if (-not $HasMutex) { exit 0 }",
  "",
  "if (-not (Test-Path $CfgFile)) { Write-Log 'config.json tidak ditemukan, agen berhenti.'; exit 1 }",
  "$Cfg    = Get-Content $CfgFile -Raw | ConvertFrom-Json",
  "$Server = [string]$Cfg.server",
  "$Key    = [string]$Cfg.key",
  "$Group  = [string]$Cfg.group",
  "$Id     = $env:COMPUTERNAME",
  "if (-not (Test-Path $RunDir)) { New-Item -ItemType Directory -Path $RunDir -Force | Out-Null }",
  "",
  "# ---------- status lokal ----------",
  "$Interval  = 10",
  "$Offset    = 0.0",
  "$ExamPath  = ''",
  "$ExamArgs  = ''",
  "$ExamProc  = ''",
  "$ExamAuto  = $true",
  "$ExamFound = ''",
  "$ExamUsed  = ''",
  "$ExamTried = @()",
  "$ExamSearchAt = [datetime]::MinValue",
  "$ExamSig   = ''",
  "$Info      = $null",
  "$InfoAt    = [datetime]::MinValue",
  "$Jobs      = @{}",
  "$Done      = New-Object System.Collections.ArrayList",
  "$Results   = New-Object System.Collections.ArrayList",
  "$Acks      = New-Object System.Collections.ArrayList",
  "$FailCount = 0",
  "$NextCheck = Get-Date",
  "$NextClean = (Get-Date).AddSeconds(20)",
  "$Restart   = $false",
  "",
  "function Save-State {",
  "  try {",
  "    $o = @{ done = @($Done | Select-Object -Last 300); results = @($Results); examFound = $script:ExamFound }",
  "    [IO.File]::WriteAllText($StateFile, (ConvertTo-Json -InputObject $o -Depth 5 -Compress), (New-Object Text.UTF8Encoding($false)))",
  "  } catch { Write-Log ('Gagal simpan state: ' + $_.Exception.Message) }",
  "}",
  "",
  "function Load-State {",
  "  if (-not (Test-Path $StateFile)) { return }",
  "  try {",
  "    $s = Get-Content $StateFile -Raw | ConvertFrom-Json",
  "    foreach ($d in @($s.done)) { if ($d) { [void]$Done.Add([string]$d) } }",
  "    if ($s.examFound) { $script:ExamFound = [string]$s.examFound }",
  "    foreach ($r in @($s.results)) {",
  "      if ($r -and $r.id) { [void]$Results.Add(@{ id = [string]$r.id; s = [string]$r.s; o = [string]$r.o; t = $r.t }) }",
  "    }",
  "  } catch { Write-Log 'state.json rusak, diabaikan.' }",
  "}",
  "",
  "function Get-NowMs { return [double][DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds() }",
  "function Get-ServerNow { return (Get-NowMs) + $script:Offset }",
  "",
  "function Get-Broadcast([string]$ip, [int]$prefix) {",
  "  try {",
  "    $b = ([System.Net.IPAddress]::Parse($ip)).GetAddressBytes()",
  "    $out = @()",
  "    for ($k = 0; $k -lt 4; $k++) {",
  "      $bits = [math]::Max(0, [math]::Min(8, $prefix - 8 * $k))",
  "      $m = [int](256 - [math]::Pow(2, 8 - $bits))",
  "      $out += ([int]$b[$k] -band $m) -bor (255 - $m)",
  "    }",
  "    return ($out -join '.')",
  "  } catch { return '' }",
  "}",
  "",
  "function Get-Info {",
  "  $i = @{ ip = ''; mac = ''; bc = ''; os = '' }",
  "  try {",
  "    $osr = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop",
  "    $cv = Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -ErrorAction SilentlyContinue",
  "    $dv = $cv.DisplayVersion",
  "    if (-not $dv) { $dv = $cv.ReleaseId }",
  "    $cap = ([string]$osr.Caption) -replace '^Microsoft\\s+', ''",
  "    if ($dv) { $i.os = $cap + ' (' + $dv + ')' } else { $i.os = $cap }",
  "  } catch {}",
  "  try {",
  "    $c = Get-NetIPConfiguration -ErrorAction Stop |",
  "      Where-Object { $_.IPv4DefaultGateway -ne $null -and $_.NetAdapter.Status -eq 'Up' } |",
  "      Select-Object -First 1",
  "    if ($c) {",
  "      $a = @($c.IPv4Address)[0]",
  "      $i.ip = [string]$a.IPAddress",
  "      $i.mac = ([string]$c.NetAdapter.MacAddress -replace '-', ':').ToUpper()",
  "      $i.bc = Get-Broadcast $a.IPAddress ([int]$a.PrefixLength)",
  "    }",
  "  } catch {}",
  "  if (-not $i.ip) {",
  "    try {",
  "      $n = Get-CimInstance Win32_NetworkAdapterConfiguration -Filter 'IPEnabled=True' |",
  "        Where-Object { $_.DefaultIPGateway } | Select-Object -First 1",
  "      if ($n) {",
  "        $i.ip = [string](@($n.IPAddress | Where-Object { $_ -match '^\\d+\\.\\d+\\.\\d+\\.\\d+$' })[0])",
  "        $i.mac = ([string]$n.MACAddress).ToUpper()",
  "        $mask = [string](@($n.IPSubnet)[0])",
  "        $pre = 0",
  "        foreach ($oct in $mask.Split('.')) { $pre += ([Convert]::ToString([int]$oct, 2).ToCharArray() | Where-Object { $_ -eq '1' }).Count }",
  "        $i.bc = Get-Broadcast $i.ip $pre",
  "      }",
  "    } catch {}",
  "  }",
  "  return $i",
  "}",
  "",
  "function Get-LoggedUser {",
  "  try {",
  "    $u = (Get-CimInstance Win32_ComputerSystem -ErrorAction Stop).UserName",
  "    if ($u) { return [string]$u }",
  "  } catch {}",
  "  try {",
  "    $p = Get-CimInstance Win32_Process -Filter \"Name='explorer.exe'\" -ErrorAction Stop | Select-Object -First 1",
  "    if ($p) {",
  "      $o = Invoke-CimMethod -InputObject $p -MethodName GetOwner",
  "      if ($o.User) { return ([string]$o.Domain + '\\' + [string]$o.User) }",
  "    }",
  "  } catch {}",
  "  return ''",
  "}",
  "",
  "function Get-ExamNames {",
  "  $names = @()",
  "  if ($script:ExamProc) {",
  "    $names = @($script:ExamProc.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ })",
  "  } else {",
  "    $p = $script:ExamUsed",
  "    if (-not $p) { $p = @(Get-ExamCandidates)[0] }",
  "    if ($p) { $names = @((Get-Leaf $p) -replace '\\.exe$', '') }",
  "  }",
  "  return $names",
  "}",
  "",
  "# ---------- lokasi Exam Browser ----------",
  "# Panel boleh mengisi beberapa lokasi (satu per baris). Agen mencoba berurutan;",
  "# jika tidak ada satu pun, agen mencari sendiri di komputer ini (bila diizinkan).",
  "function Get-Leaf([string]$path) { return ([string]$path -split '[\\\\/]')[-1] }",
  "",
  "function Get-ExamCandidates {",
  "  $list = @()",
  "  foreach ($c in ([string]$script:ExamPath -split \"\\r?\\n|\\|\")) {",
  "    $c = $c.Trim().Trim('\"').Trim()",
  "    if ($c) { $list += [Environment]::ExpandEnvironmentVariables($c) }",
  "  }",
  "  return $list",
  "}",
  "",
  "function Get-ExamFileNames {",
  "  $names = @()",
  "  foreach ($c in (Get-ExamCandidates)) {",
  "    $leaf = Get-Leaf $c",
  "    if ($leaf -and $leaf -like '*.exe' -and $names -notcontains $leaf) { $names += $leaf }",
  "  }",
  "  if ($names.Count -eq 0 -and $script:ExamProc) {",
  "    foreach ($n in $script:ExamProc.Split(',')) {",
  "      $n = $n.Trim()",
  "      if ($n -and $n -notmatch '[\\*\\?]') { $names += ($n + '.exe') }",
  "    }",
  "  }",
  "  return $names",
  "}",
  "",
  "function Get-UserDirs([string]$sub) {",
  "  $out = @()",
  "  try {",
  "    if (-not $env:SystemDrive) { return $out }",
  "    Get-ChildItem -Path ($env:SystemDrive + '\\Users') -Directory -ErrorAction SilentlyContinue | ForEach-Object {",
  "      $d = Join-Path $_.FullName $sub",
  "      if (Test-Path -LiteralPath $d) { $out += $d }",
  "    }",
  "  } catch {}",
  "  return $out",
  "}",
  "",
  "function Find-ExamExe {",
  "  $names = @(Get-ExamFileNames)",
  "  if ($names.Count -eq 0) { return '' }",
  "  # 1. registri App Paths",
  "  foreach ($n in $names) {",
  "    foreach ($root in @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\App Paths')) {",
  "      try {",
  "        $v = (Get-ItemProperty -Path ($root + '\\' + $n) -ErrorAction Stop).'(default)'",
  "        if ($v) { $v = $v.Trim('\"'); if (Test-Path -LiteralPath $v -PathType Leaf) { return $v } }",
  "      } catch {}",
  "    }",
  "  }",
  "  # 2. shortcut di Desktop dan Start Menu",
  "  $lnkDirs = @()",
  "  if ($env:PUBLIC) { $lnkDirs += (Join-Path $env:PUBLIC 'Desktop') }",
  "  if ($env:ProgramData) { $lnkDirs += (Join-Path $env:ProgramData 'Microsoft\\Windows\\Start Menu\\Programs') }",
  "  $lnkDirs += Get-UserDirs 'Desktop'",
  "  $lnkDirs += Get-UserDirs 'OneDrive\\Desktop'",
  "  $lnkDirs += Get-UserDirs 'AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs'",
  "  try {",
  "    $sh = New-Object -ComObject WScript.Shell",
  "    foreach ($d in $lnkDirs) {",
  "      if (-not (Test-Path -LiteralPath $d)) { continue }",
  "      foreach ($l in @(Get-ChildItem -LiteralPath $d -Filter '*.lnk' -Recurse -Depth 3 -File -ErrorAction SilentlyContinue)) {",
  "        try {",
  "          $t = [string]$sh.CreateShortcut($l.FullName).TargetPath",
  "          if ($t -and ($names -contains (Get-Leaf $t)) -and (Test-Path -LiteralPath $t -PathType Leaf)) { return $t }",
  "        } catch {}",
  "      }",
  "    }",
  "  } catch {}",
  "  # 3. folder instalasi yang umum",
  "  $roots = @()",
  "  foreach ($r in @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:ProgramData)) { if ($r) { $roots += ,@($r, 4) } }",
  "  foreach ($r in (Get-UserDirs 'AppData\\Local\\Programs')) { $roots += ,@($r, 3) }",
  "  foreach ($r in (Get-UserDirs 'AppData\\Local')) { $roots += ,@($r, 2) }",
  "  foreach ($r in (Get-UserDirs 'Desktop')) { $roots += ,@($r, 3) }",
  "  foreach ($r in (Get-UserDirs 'Downloads')) { $roots += ,@($r, 2) }",
  "  $roots += ,@(($env:SystemDrive + '\\'), 1)",
  "  try {",
  "    Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' -ErrorAction SilentlyContinue | ForEach-Object {",
  "      if ($_.DeviceID -ne $env:SystemDrive) { $roots += ,@(($_.DeviceID + '\\'), 2) }",
  "    }",
  "  } catch {}",
  "  foreach ($pair in $roots) {",
  "    foreach ($n in $names) {",
  "      $f = Get-ChildItem -LiteralPath $pair[0] -Filter $n -Recurse -Depth $pair[1] -File -ErrorAction SilentlyContinue | Select-Object -First 1",
  "      if ($f) { return $f.FullName }",
  "    }",
  "  }",
  "  return ''",
  "}",
  "",
  "function Resolve-ExamPath([switch]$Force) {",
  "  $cands = @(Get-ExamCandidates)",
  "  $script:ExamTried = $cands",
  "  foreach ($c in $cands) {",
  "    if (Test-Path -LiteralPath $c -PathType Leaf) { $script:ExamUsed = $c; return $c }",
  "  }",
  "  if (-not $script:ExamAuto) { $script:ExamUsed = ''; return '' }",
  "  $names = @(Get-ExamFileNames)",
  "  if ($script:ExamFound -and ($names -contains (Get-Leaf $script:ExamFound)) -and (Test-Path -LiteralPath $script:ExamFound -PathType Leaf)) {",
  "    $script:ExamUsed = $script:ExamFound; return $script:ExamFound",
  "  }",
  "  if (-not $Force -and ((Get-Date) - $script:ExamSearchAt).TotalMinutes -lt 10) { $script:ExamUsed = ''; return '' }",
  "  $script:ExamSearchAt = Get-Date",
  "  $t0 = Get-Date",
  "  $found = Find-ExamExe",
  "  $secs = [math]::Round(((Get-Date) - $t0).TotalSeconds, 1)",
  "  if ($found) { Write-Log ('Exam Browser ditemukan otomatis: ' + $found + ' (' + $secs + ' dtk)') }",
  "  else { Write-Log ('Exam Browser tidak ditemukan (pencarian ' + $secs + ' dtk).') }",
  "  $script:ExamFound = $found",
  "  Save-State",
  "  $script:ExamUsed = $found",
  "  return $found",
  "}",
  "",
  "function Get-ExamProcesses {",
  "  $names = Get-ExamNames",
  "  if ($names.Count -eq 0) { return @() }",
  "  return @(Get-Process -Name $names -ErrorAction SilentlyContinue)",
  "}",
  "",
  "function ConvertTo-Vbs([string]$s) {",
  "  $s = $s -replace '\"', '\"\"'",
  "  $s = $s -replace \"`r`n|`n|`r\", '\" & vbCrLf & \"'",
  "  return '\"' + $s + '\"'",
  "}",
  "",
  "# Menjalankan skrip VBS kecil di sesi pengguna yang sedang login",
  "# (agen berjalan sebagai SYSTEM sehingga tidak punya layar sendiri).",
  "function Invoke-AsUser([string]$vbsBody, [string]$tag) {",
  "  $user = Get-LoggedUser",
  "  if (-not $user) { throw 'Tidak ada pengguna yang sedang login di komputer ini.' }",
  "  $name = 'PL-' + $tag + '-' + ([guid]::NewGuid().ToString('N').Substring(0, 8))",
  "  $file = Join-Path $RunDir ($name + '.vbs')",
  "  [IO.File]::WriteAllText($file, $vbsBody, [Text.Encoding]::Unicode)",
  "  $act = New-ScheduledTaskAction -Execute 'wscript.exe' -Argument ('//Nologo \"' + $file + '\"')",
  "  $pri = New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited",
  "  $set = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances Parallel",
  "  Register-ScheduledTask -TaskName $name -TaskPath $TaskPath -Action $act -Principal $pri -Settings $set -Force -ErrorAction Stop | Out-Null",
  "  Start-ScheduledTask -TaskName $name -TaskPath $TaskPath -ErrorAction Stop",
  "  return $user",
  "}",
  "",
  "function Clear-RunTasks {",
  "  try {",
  "    Get-ScheduledTask -TaskPath $TaskPath -ErrorAction SilentlyContinue |",
  "      Where-Object { $_.State -ne 'Running' } |",
  "      ForEach-Object { Unregister-ScheduledTask -TaskName $_.TaskName -TaskPath $_.TaskPath -Confirm:$false -ErrorAction SilentlyContinue }",
  "    Get-ChildItem $RunDir -Filter '*.vbs' -ErrorAction SilentlyContinue |",
  "      Where-Object { $_.LastWriteTime -lt (Get-Date).AddMinutes(-10) } |",
  "      Remove-Item -Force -ErrorAction SilentlyContinue",
  "  } catch {}",
  "}",
  "",
  "function Send-Wol($list) {",
  "  $udp = New-Object System.Net.Sockets.UdpClient",
  "  $udp.EnableBroadcast = $true",
  "  $count = 0",
  "  try {",
  "    foreach ($t in @($list)) {",
  "      if (-not $t) { continue }",
  "      $hex = ([string]$t.m) -replace '[^0-9A-Fa-f]', ''",
  "      if ($hex.Length -ne 12) { continue }",
  "      $mac = New-Object byte[] 6",
  "      for ($x = 0; $x -lt 6; $x++) { $mac[$x] = [Convert]::ToByte($hex.Substring($x * 2, 2), 16) }",
  "      $pkt = New-Object byte[] 102",
  "      for ($x = 0; $x -lt 6; $x++) { $pkt[$x] = 0xFF }",
  "      for ($r = 0; $r -lt 16; $r++) { for ($x = 0; $x -lt 6; $x++) { $pkt[6 + $r * 6 + $x] = $mac[$x] } }",
  "      $dests = @('255.255.255.255')",
  "      if ($t.b) { $dests += [string]$t.b }",
  "      for ($round = 0; $round -lt 3; $round++) {",
  "        foreach ($d in $dests) {",
  "          foreach ($port in @(9, 7)) {",
  "            try { [void]$udp.Send($pkt, $pkt.Length, $d, $port) } catch {}",
  "          }",
  "        }",
  "        Start-Sleep -Milliseconds 120",
  "      }",
  "      $count++",
  "    }",
  "  } finally { $udp.Close() }",
  "  return $count",
  "}",
  "",
  "function Add-Result([string]$jobId, [string]$status, [string]$output) {",
  "  if ($output.Length -gt 900) { $output = $output.Substring(0, 900) }",
  "  [void]$Results.Add(@{ id = $jobId; s = $status; o = $output; t = (Get-ServerNow) })",
  "  Save-State",
  "  $script:NextCheck = Get-Date",
  "}",
  "",
  "function Invoke-Api($body) {",
  "  $json = ConvertTo-Json -InputObject $body -Depth 6 -Compress",
  "  $bytes = [Text.Encoding]::UTF8.GetBytes($json)",
  "  return Invoke-RestMethod -Uri $Server -Method Post -Body $bytes -ContentType 'text/plain; charset=utf-8' -TimeoutSec 40 -UseBasicParsing",
  "}",
  "",
  "function Invoke-Checkin {",
  "  if (((Get-Date) - $script:InfoAt).TotalSeconds -gt 60 -or -not $script:Info) {",
  "    $script:Info = Get-Info",
  "    $script:InfoAt = Get-Date",
  "    if ($script:ExamSig) { [void](Resolve-ExamPath) }",
  "  }",
  "  $sendResults = @($Results.ToArray())",
  "  $sendAcks = @($Acks.ToArray())",
  "  $examRunning = (@(Get-ExamProcesses).Count -gt 0)",
  "  $body = @{",
  "    k = $Key; a = 'checkin'; id = $Id; ver = $AgentVersion; grp = $Group",
  "    user = (Get-LoggedUser); exam = $examRunning",
  "    ip = $script:Info.ip; mac = $script:Info.mac; bc = $script:Info.bc; os = $script:Info.os",
  "    results = $sendResults; acks = $sendAcks",
  "    exp = $script:ExamUsed; eok = [bool]$script:ExamUsed; ecfg = [bool]$script:ExamSig",
  "  }",
  "  $t0 = Get-NowMs",
  "  $res = Invoke-Api $body",
  "  $t1 = Get-NowMs",
  "  if (-not $res -or -not $res.ok) {",
  "    $err = 'respon tidak dikenal'",
  "    if ($res -and $res.error) { $err = [string]$res.error }",
  "    throw ('Server menolak: ' + $err)",
  "  }",
  "  # hapus hasil & ack yang sudah terkirim",
  "  foreach ($r in $sendResults) { $Results.Remove($r) }",
  "  foreach ($a in $sendAcks) { $Acks.Remove($a) }",
  "  if ($sendResults.Count -gt 0) { Save-State }",
  "",
  "  $script:Offset = [double]$res.now - (($t0 + $t1) / 2)",
  "  if ($res.interval) { $script:Interval = [math]::Max(3, [int]$res.interval) }",
  "  if ($res.cfg) {",
  "    $script:ExamPath = [string]$res.cfg.examPath",
  "    $script:ExamArgs = [string]$res.cfg.examArgs",
  "    $script:ExamProc = [string]$res.cfg.examProc",
  "    $script:ExamAuto = ($res.cfg.examAuto -ne $false)",
  "    $sig = $script:ExamPath + '|' + $script:ExamProc + '|' + $script:ExamAuto",
  "    if ($sig -ne $script:ExamSig) {",
  "      # pengaturan lokasi berubah: cek ulang segera pada laporan berikutnya",
  "      $script:ExamSig = $sig",
  "      $script:ExamSearchAt = [datetime]::MinValue",
  "      [void](Resolve-ExamPath)",
  "      $script:NextCheck = Get-Date",
  "    }",
  "  }",
  "",
  "  # sinkronkan antrean perintah",
  "  $seen = @{}",
  "  foreach ($j in @($res.jobs)) {",
  "    if (-not $j -or -not $j.id) { continue }",
  "    $jid = [string]$j.id",
  "    $seen[$jid] = $true",
  "    if ($Done -contains $jid) {",
  "      $pending = $false",
  "      foreach ($r in $Results) { if ($r.id -eq $jid) { $pending = $true } }",
  "      if (-not $pending) { Add-Result $jid 'ok' 'Sudah dijalankan sebelumnya.' }",
  "      continue",
  "    }",
  "    if (-not $Jobs.ContainsKey($jid)) {",
  "      $Jobs[$jid] = $j",
  "      [void]$Acks.Add($jid)",
  "      Write-Log ('Perintah diterima: ' + $j.a + ' (' + $jid + ')')",
  "    }",
  "  }",
  "  foreach ($k in @($Jobs.Keys)) { if (-not $seen.ContainsKey($k)) { $Jobs.Remove($k) } }",
  "}",
  "",
  "function Invoke-Job($j) {",
  "  $jid = [string]$j.id",
  "  [void]$Done.Add($jid)",
  "  Save-State",
  "  $p = $j.p",
  "  Write-Log ('Menjalankan ' + $j.a + ' (' + $jid + ')')",
  "  try {",
  "    switch ([string]$j.a) {",
  "      'run_exam' {",
  "        if (-not $script:ExamPath -and -not $script:ExamProc) { throw 'Lokasi Exam Browser belum diatur di panel (Pustaka Skrip).' }",
  "        $running = @(Get-ExamProcesses)",
  "        if ($running.Count -gt 0) { Add-Result $jid 'ok' 'Exam Browser sudah berjalan.'; return }",
  "        $exe = Resolve-ExamPath -Force",
  "        $script:NextCheck = Get-Date",
  "        if (-not $exe) {",
  "          $msg = 'Exam Browser tidak ditemukan di komputer ini.'",
  "          if ($script:ExamTried.Count) { $msg += ' Sudah dicek: ' + ($script:ExamTried -join '; ') + '.' }",
  "          if ($script:ExamAuto) { $msg += ' Pencarian otomatis juga tidak menemukan.' }",
  "          $msg += ' Atur lokasi khusus komputer ini di panel (menu Endpoint).'",
  "          throw $msg",
  "        }",
  "        $cmd = '\"' + $exe + '\"'",
  "        if ($script:ExamArgs) { $cmd += ' ' + $script:ExamArgs }",
  "        $vbs = 'Set sh = CreateObject(\"WScript.Shell\")' + \"`r`n\"",
  "        $vbs += 'sh.CurrentDirectory = ' + (ConvertTo-Vbs ([IO.Path]::GetDirectoryName($exe))) + \"`r`n\"",
  "        $vbs += 'sh.Run ' + (ConvertTo-Vbs $cmd) + ', 3, False'",
  "        $u = Invoke-AsUser $vbs 'exam'",
  "        $ok = $false",
  "        for ($w = 0; $w -lt 16; $w++) {",
  "          Start-Sleep -Milliseconds 500",
  "          if (@(Get-ExamProcesses).Count -gt 0) { $ok = $true; break }",
  "        }",
  "        if ($ok) { Add-Result $jid 'ok' ('Exam Browser dibuka untuk ' + $u + ' (' + $exe + ').') }",
  "        else { Add-Result $jid 'ok' ('Perintah buka dikirim ke ' + $u + ' (proses belum terdeteksi, cek nama proses di panel).') }",
  "      }",
  "      'close_exam' {",
  "        $procs = @(Get-ExamProcesses)",
  "        if ($procs.Count -eq 0) { Add-Result $jid 'ok' 'Tidak ada Exam Browser yang berjalan.'; return }",
  "        $procs | Stop-Process -Force -ErrorAction SilentlyContinue",
  "        $left = 0",
  "        for ($w = 0; $w -lt 8; $w++) {",
  "          Start-Sleep -Milliseconds 500",
  "          $rest = @(Get-ExamProcesses)",
  "          $left = $rest.Count",
  "          if ($left -eq 0) { break }",
  "          $rest | Stop-Process -Force -ErrorAction SilentlyContinue",
  "        }",
  "        if ($left -eq 0) { Add-Result $jid 'ok' ('Exam Browser ditutup (' + $procs.Count + ' proses).') }",
  "        else { Add-Result $jid 'err' ('Masih ada ' + $left + ' proses yang belum tertutup.') }",
  "      }",
  "      'wol' {",
  "        $n = Send-Wol $p.macs",
  "        if ($n -gt 0) { Add-Result $jid 'ok' ('Magic packet dikirim oleh ' + $Id + ' ke ' + $n + ' komputer.') }",
  "        else { Add-Result $jid 'err' 'Tidak ada alamat MAC yang valid.' }",
  "      }",
  "      'shutdown' {",
  "        Add-Result $jid 'ok' 'Komputer dimatikan.'",
  "        try { Invoke-Checkin } catch {}",
  "        & shutdown.exe /s /f /t 5 /c \"Komputer dimatikan oleh Proktor (ProktorLab).\" | Out-Null",
  "      }",
  "      'restart' {",
  "        Add-Result $jid 'ok' 'Komputer dimulai ulang.'",
  "        try { Invoke-Checkin } catch {}",
  "        & shutdown.exe /r /f /t 5 /c \"Komputer dimulai ulang oleh Proktor (ProktorLab).\" | Out-Null",
  "      }",
  "      'logoff' {",
  "        $vbs = 'CreateObject(\"WScript.Shell\").Run \"shutdown.exe /l /f\", 0, False'",
  "        $u = Invoke-AsUser $vbs 'logoff'",
  "        Add-Result $jid 'ok' ('Log off dikirim ke ' + $u + '.')",
  "      }",
  "      'lock' {",
  "        $vbs = 'CreateObject(\"WScript.Shell\").Run \"rundll32.exe user32.dll,LockWorkStation\", 0, False'",
  "        $u = Invoke-AsUser $vbs 'lock'",
  "        Add-Result $jid 'ok' ('Layar dikunci (' + $u + ').')",
  "      }",
  "      'message' {",
  "        $text = [string]$p.text",
  "        if (-not $text) { throw 'Isi pesan kosong.' }",
  "        $vbs = 'CreateObject(\"WScript.Shell\").Popup ' + (ConvertTo-Vbs $text) + ', 0, \"Pesan dari Proktor\", 4160'",
  "        $u = Invoke-AsUser $vbs 'msg'",
  "        Add-Result $jid 'ok' ('Pesan ditampilkan ke ' + $u + '.')",
  "      }",
  "      'open_url' {",
  "        $url = [string]$p.url",
  "        if ($url -notmatch '^https?://') { throw 'URL harus diawali http:// atau https://' }",
  "        $vbs = 'CreateObject(\"WScript.Shell\").Run ' + (ConvertTo-Vbs $url) + ', 1, False'",
  "        $u = Invoke-AsUser $vbs 'url'",
  "        Add-Result $jid 'ok' ('Situs dibuka untuk ' + $u + '.')",
  "      }",
  "      'update_agent' {",
  "        $sep = '?'",
  "        if ($Server.Contains('?')) { $sep = '&' }",
  "        $resp = Invoke-WebRequest -Uri ($Server + $sep + 'f=agent&k=' + [uri]::EscapeDataString($Key)) -UseBasicParsing -TimeoutSec 60",
  "        $code = [string]$resp.Content",
  "        if (-not $code.StartsWith('# ProktorLab Agent')) { throw 'Unduhan agen tidak valid.' }",
  "        $target = Join-Path $Base 'agent.ps1'",
  "        [IO.File]::WriteAllText($target, $code, (New-Object Text.UTF8Encoding($true)))",
  "        Add-Result $jid 'ok' 'Agen diperbarui, memulai ulang agen...'",
  "        try { Invoke-Checkin } catch {}",
  "        $script:Restart = $true",
  "      }",
  "      default { throw ('Aksi tidak dikenal: ' + $j.a) }",
  "    }",
  "  } catch {",
  "    Add-Result $jid 'err' ([string]$_.Exception.Message)",
  "    Write-Log ('Gagal ' + $j.a + ': ' + $_.Exception.Message)",
  "  }",
  "}",
  "",
  "function Invoke-DueJobs {",
  "  if ($Jobs.Count -eq 0) { return }",
  "  $now = Get-ServerNow",
  "  $due = @($Jobs.Values | Where-Object { [double]$_.at -le $now } | Sort-Object { [double]$_.at })",
  "  foreach ($j in $due) {",
  "    $Jobs.Remove([string]$j.id)",
  "    if ([double]$j.dl -lt $now) {",
  "      [void]$Done.Add([string]$j.id)",
  "      Add-Result ([string]$j.id) 'err' 'Kedaluwarsa: melewati batas waktu penyelesaian.'",
  "      continue",
  "    }",
  "    Invoke-Job $j",
  "    if ($script:Restart) { return }",
  "  }",
  "}",
  "",
  "# ---------------- loop utama ----------------",
  "Load-State",
  "Write-Log ('Agen v' + $AgentVersion + ' mulai. Server: ' + $Server)",
  "try {",
  "  while (-not $script:Restart) {",
  "    if ((Get-Date) -ge $NextCheck) {",
  "      try {",
  "        Invoke-Checkin",
  "        $FailCount = 0",
  "        $NextCheck = (Get-Date).AddSeconds($Interval)",
  "      } catch {",
  "        $FailCount++",
  "        $wait = [math]::Min(60, 5 * $FailCount)",
  "        if ($FailCount -le 3 -or $FailCount % 20 -eq 0) { Write-Log ('Gagal lapor ke server: ' + $_.Exception.Message) }",
  "        $NextCheck = (Get-Date).AddSeconds($wait)",
  "      }",
  "    }",
  "    Invoke-DueJobs",
  "    if ((Get-Date) -ge $NextClean) { Clear-RunTasks; $NextClean = (Get-Date).AddSeconds(60) }",
  "    Start-Sleep -Milliseconds 500",
  "  }",
  "} finally {",
  "  try { $Mutex.ReleaseMutex() } catch {}",
  "  if ($script:Restart) {",
  "    # tunggu proses ini selesai, lalu jalankan ulang tugas terjadwal agen",
  "    Write-Log 'Memulai ulang agen setelah pembaruan.'",
  "    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c ping -n 5 127.0.0.1 >nul & schtasks /run /tn \"ProktorLab Agent\" >nul' -WindowStyle Hidden",
  "  }",
  "}"
].join('\n');

// Pemasang agen (dipanggil lewat ?f=install)
var INSTALL_PS1 = [
  "# ProktorLab - Pemasang Agen",
  "# Jalankan di PowerShell (Administrator) pada setiap komputer lab.",
  "$ErrorActionPreference = 'Stop'",
  "try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}",
  "$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
  "if (-not $isAdmin) {",
  "  Write-Host ''",
  "  Write-Host 'GAGAL: PowerShell belum dibuka sebagai Administrator.' -ForegroundColor Red",
  "  Write-Host 'Klik kanan Start > Terminal (Admin) / Windows PowerShell (Admin), lalu tempel perintah lagi.' -ForegroundColor Yellow",
  "  return",
  "}",
  "$Base = Join-Path $env:ProgramData 'ProktorLab'",
  "$TaskName = 'ProktorLab Agent'",
  "Write-Host ''",
  "Write-Host '=== Memasang Agen ProktorLab di' $env:COMPUTERNAME '===' -ForegroundColor Cyan",
  "",
  "# 1. hentikan agen lama bila ada",
  "try { Stop-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue } catch {}",
  "Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\" -ErrorAction SilentlyContinue |",
  "  Where-Object { $_.CommandLine -like '*ProktorLab\\agent.ps1*' } |",
  "  ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }",
  "",
  "# 2. folder agen (hanya SYSTEM & Administrator yang boleh mengubah)",
  "New-Item -ItemType Directory -Path $Base -Force | Out-Null",
  "New-Item -ItemType Directory -Path (Join-Path $Base 'run') -Force | Out-Null",
  "& icacls.exe $Base /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' '*S-1-5-32-545:(OI)(CI)RX' | Out-Null",
  "Write-Host '[1/4] Folder agen siap:' $Base",
  "",
  "# 3. tulis agen + konfigurasi",
  "$agent = @'",
  "{{AGENT}}",
  "'@",
  "[IO.File]::WriteAllText((Join-Path $Base 'agent.ps1'), $agent, (New-Object Text.UTF8Encoding($true)))",
  "$cfg = ConvertTo-Json -InputObject @{ server = '{{URL}}'; key = '{{KEY}}'; group = '{{GROUP}}' }",
  "$cfgPath = Join-Path $Base 'config.json'",
  "[IO.File]::WriteAllText($cfgPath, $cfg, (New-Object Text.UTF8Encoding($false)))",
  "& icacls.exe $cfgPath /inheritance:r /grant:r '*S-1-5-18:F' '*S-1-5-32-544:F' | Out-Null",
  "Write-Host '[2/4] Agen & konfigurasi ditulis.'",
  "",
  "# 4. tugas terjadwal: jalan saat komputer menyala + penjaga tiap 5 menit",
  "$ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
  "$act = New-ScheduledTaskAction -Execute $ps -Argument ('-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File \"' + (Join-Path $Base 'agent.ps1') + '\"')",
  "$triggers = @(New-ScheduledTaskTrigger -AtStartup)",
  "try { $triggers += New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1) -RepetitionInterval (New-TimeSpan -Minutes 5) } catch {}",
  "$pri = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest",
  "$set = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1)",
  "Register-ScheduledTask -TaskName $TaskName -Action $act -Trigger $triggers -Principal $pri -Settings $set -Description 'Agen ProktorLab: menerima perintah dari Panel Proktor (buka/tutup Exam Browser, WOL, shutdown).' -Force | Out-Null",
  "Write-Host '[3/4] Tugas terjadwal \"ProktorLab Agent\" dibuat.'",
  "",
  "# 5. Wake on LAN: matikan Fast Startup agar komputer bisa dinyalakan dari jaringan",
  "try {",
  "  New-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power' -Name 'HiberbootEnabled' -Value 0 -PropertyType DWord -Force | Out-Null",
  "  Get-NetAdapter -Physical -ErrorAction SilentlyContinue | Where-Object { $_.Status -eq 'Up' } | ForEach-Object {",
  "    try { Set-NetAdapterPowerManagement -Name $_.Name -WakeOnMagicPacket Enabled -ErrorAction SilentlyContinue } catch {}",
  "  }",
  "} catch {}",
  "",
  "Start-ScheduledTask -TaskName $TaskName",
  "Write-Host '[4/4] Agen dijalankan.'",
  "Write-Host ''",
  "Write-Host ('BERHASIL! ' + $env:COMPUTERNAME + ' akan muncul di Panel Proktor dalam beberapa detik.') -ForegroundColor Green",
  "Write-Host ''"
].join('\n');

